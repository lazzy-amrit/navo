# InSQL backend - required environment (copy to Backend/.env)

# --- Auth (already required by Auth/services/config.py) ---
SECRET_KEY=change-me

# --- metadata database (our own SQLite, not customer data) ---
DATABASE_PATH=insql.db

# --- Turso (never exposed to customers) ---
TURSO_ORG=your-turso-org-slug
TURSO_PLATFORM_TOKEN=your-turso-platform-token
# Fernet key for encrypting stored Turso JWTs:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TURSO_ENC_KEY=

# --- Turso (optional overrides) ---
TURSO_GROUP=default
TURSO_LOCATION=aws-ap-south-1
TURSO_MAX_DATABASES=100
TURSO_HTTP_TIMEOUT=15

# --- proxy / public ---
PUBLIC_BASE_URL=http://localhost:8000
PROXY_MAX_BODY_BYTES=1048576
PROXY_MAX_CONCURRENT_PER_DB=10
USAGE_SYNC_INTERVAL_SECONDS=300

# --- plan overrides (defaults come from prices.md) ---
# PLAN_FREE_DATABASES=1
# PLAN_FREE_STORAGE_MB=60
# PLAN_FREE_READS=5000000
# PLAN_FREE_WRITES=75000
# PLAN_PRO_DATABASES=1
# PLAN_PRO_STORAGE_MB=200
# PLAN_PRO_READS=10000000
# PLAN_PRO_WRITES=400000
